# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public address of the site, used in e-mail links and certificates
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "mock" marks every payment as paid immediately (for testing).
# "whatsapp": the student writes to WHATSAPP_NUMBER and the admin confirms the payment in /admin.
PAYMENT_PROVIDER=mock
# The school's WhatsApp number, e.g. +994501234567 (only used with PAYMENT_PROVIDER=whatsapp)
WHATSAPP_NUMBER=
